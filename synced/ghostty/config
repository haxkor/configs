font-size = 20

font-family = "Berkeley Mono"
font-thicken = true

font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Navigate between splits with vim-style keys
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

# Create new splits
keybind = ctrl+s=new_split:down
keybind = ctrl+v=new_split:right

term = xterm-256color

command = /opt/homebrew/bin/fish
